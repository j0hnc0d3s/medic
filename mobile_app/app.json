{
  "expo": {
    "name": "Medic",
    "slug": "medic-patient-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "main": "expo-router/entry",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flowstate.medic.patient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.flowstate.medic.patient"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}

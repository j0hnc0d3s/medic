// =========================================
// FIRESTORE SECURITY RULES - Medic-Clinic
// Copy this entire file to Firebase Console
// =========================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function - check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function - check user role
    function hasRole(role) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Helper function - check if admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Helper function - check if staff (doctor, nurse, receptionist, staff)
    function isStaff() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'doctor', 'nurse', 'receptionist', 'staff'];
    }
    
    // Helper function - check if patient owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Anyone can read their own user document
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Any authenticated user can read a doctor's directory entry.
      // (BUG FIX Oct 2026: patients need this to see/message their
      // assigned doctor — authService.getUsersByRole('doctor') is
      // called from PatientSidebar and PatientOverview to build the
      // doctor-contacts list, and with no rule covering it, every
      // call failed with "Missing or insufficient permissions",
      // confirmed live.)
      allow read: if isAuthenticated() && resource.data.role == 'doctor';
      
      // Only admins can create/update/delete users
      allow write: if isAdmin();
    }

    // ==========================================
    // PATIENTS COLLECTION
    // ==========================================
    match /patients/{patientId} {
      // Staff can read all patients
      allow read: if isStaff();
      
      // Patients can read their own record
      allow read: if isOwner(resource.data.userId);
      
      // Staff can create/update/delete patients
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // STAFF COLLECTION
    // ==========================================
    match /staff/{staffId} {
      // Staff can read all staff members
      allow read: if isStaff();
      
      // Only admins can create/update/delete staff
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // APPOINTMENTS COLLECTION
    // ==========================================
    match /appointments/{appointmentId} {
      // Staff can read all appointments
      allow read: if isStaff();
      
      // Patients can read their own appointments
      allow read: if isOwner(resource.data.patientId);
      
      // Staff can create/update/delete appointments
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // FINANCES COLLECTION (NEW UNIFIED)
    // ==========================================
    match /finances/{financeId} {
      // Only staff can read finances
      allow read: if isStaff();
      
      // Only admins can create/update/delete finances
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // INCOME COLLECTION (OLD - LEGACY)
    // Keep for backward compatibility
    // ==========================================
    match /income/{incomeId} {
      // Only staff can read income
      allow read: if isStaff();
      
      // Only admins can create/update/delete income
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // EXPENDITURE COLLECTION (OLD - LEGACY)
    // Keep for backward compatibility
    // ==========================================
    match /expenditure/{expenditureId} {
      // Only staff can read expenditure
      allow read: if isStaff();
      
      // Only admins can create/update/delete expenditure
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // NOTIFICATIONS COLLECTION
    // ==========================================
    match /notifications/{notificationId} {
      // Users can read their own notifications
      // (BUG FIX Oct 2026: notification docs are created with a single
      // `userId` field — see notificationService.createNotification() —
      // never a `recipients` array. The old rule checked a field that
      // never existed, so resource.data.recipients evaluated to null
      // and every read/update was silently denied.)
      allow read: if isAuthenticated() && 
                     request.auth.uid == resource.data.userId;
      
      // Staff can create notifications
      allow create: if isStaff();
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       request.auth.uid == resource.data.userId;
      
      // Only admins can delete notifications
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCUMENTS COLLECTION
    // ==========================================
    match /documents/{documentId} {
      // Staff can read all documents
      allow read: if isStaff();
      
      // Patients can read their own documents
      allow read: if isOwner(resource.data.patientId);
      
      // Staff can create/update/delete documents
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // IMAGING COLLECTION
    // (BUG FIX Oct 2026: this collection had no rule at all, so
    // Firestore default-denied every read/write — staff and patients
    // both got "Missing or insufficient permissions" on every imaging
    // query. Mirrors the documents/appointments pattern.)
    // ==========================================
    match /imaging/{imagingId} {
      // Staff can read all imaging records
      allow read: if isStaff();
      
      // Patients can read their own imaging records
      allow read: if isOwner(resource.data.patientId);
      
      // Staff can create/update/delete imaging records
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // LABS COLLECTION
    // (BUG FIX Oct 2026: same missing-rule issue as imaging above.)
    // ==========================================
    match /labs/{labId} {
      // Staff can read all lab records
      allow read: if isStaff();
      
      // Patients can read their own lab records
      allow read: if isOwner(resource.data.patientId);
      
      // Staff can create/update/delete lab records
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // NOTES COLLECTION
    // (BUG FIX Oct 2026: same missing-rule issue as imaging/labs
    // above — notes had no rule at all, so every read was
    // default-denied, confirmed live via "Get notes error: Missing
    // or insufficient permissions" on /staff/notes.)
    // ==========================================
    match /notes/{noteId} {
      // Staff can read all notes
      allow read: if isStaff();
      
      // Patients can read their own notes
      allow read: if isOwner(resource.data.patientId);
      
      // Staff can create/update/delete notes
      allow create, update, delete: if isStaff();
    }

    // ==========================================
    // ACTIVITIES COLLECTION (AUDIT LOG)
    // ==========================================
    match /activities/{activityId} {
      // Only staff can read activities
      allow read: if isStaff();
      
      // Anyone authenticated can create activity logs
      allow create: if isAuthenticated();
      
      // Only admins can delete activities
      allow delete: if isAdmin();
    }

    // ==========================================
    // CONVERSATIONS COLLECTION (MESSAGING)
    // ==========================================
    match /conversations/{conversationId} {
      // Users can read conversations they're part of
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.participants;
      
      // Users can create conversations
      allow create: if isAuthenticated() && 
                       request.auth.uid in request.resource.data.participants;
      
      // Participants can update conversation
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() && 
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Participants can create messages
        allow create: if isAuthenticated() && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Only sender can update their own message
        allow update: if isAuthenticated() && 
                         request.auth.uid == resource.data.senderId;
      }
    }

    // ==========================================
    // REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      // Only staff can read reports
      allow read: if isStaff();
      
      // Only admins can create/update/delete reports
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // SETTINGS COLLECTION
    // ==========================================
    match /settings/{settingId} {
      // Staff can read settings
      allow read: if isStaff();
      
      // Only admins can update settings
      allow write: if isAdmin();
    }
    
    // ==========================================
    // CONVERSATIONS COLLECTION
    // ==========================================
    
    match /conversations/{conversationId} {
      
      // Helper function to check if user is participant
      function isParticipant() {
        return request.auth != null && 
               request.auth.uid in resource.data.participants;
      }
      
      function isNewParticipant() {
        return request.auth != null && 
               request.auth.uid in request.resource.data.participants;
      }
      
      // READ: Users can read conversations they're part of
      allow read: if isParticipant();
      
      // CREATE: Users can create conversations they're part of
      allow create: if isNewParticipant() &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.keys().hasAll([
                         'participants', 
                         'participantDetails', 
                         'lastMessage', 
                         'lastMessageAt',
                         'unreadCount'
                       ]);
      
      // UPDATE: Participants can update conversation (for last message, unread count)
      allow update: if isParticipant() &&
                       request.resource.data.participants == resource.data.participants;
      
      // DELETE: Not allowed (conversations should be archived, not deleted)
      allow delete: if false;
      
      
      // ==========================================
      // MESSAGES SUBCOLLECTION
      // ==========================================
      
      match /messages/{messageId} {
        
        // Helper to check conversation participant
        function isConversationParticipant() {
          return request.auth != null && 
                 request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        
        // Helper to check if user is message sender
        function isSender() {
          return request.auth != null &&
                 request.auth.uid == request.resource.data.senderId;
        }
        
        // READ: Participants can read all messages
        allow read: if isConversationParticipant();
        
        // CREATE: Participants can create messages if they're the sender
        allow create: if isConversationParticipant() &&
                         isSender() &&
                         request.resource.data.keys().hasAll([
                           'text',
                           'senderId', 
                           'senderName',
                           'senderRole',
                           'timestamp',
                           'read'
                         ]);
        
        // UPDATE: Can mark as read
        allow update: if isConversationParticipant() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        
        // DELETE: Only sender can delete their own messages (within 5 minutes)
        allow delete: if isConversationParticipant() &&
                         request.auth.uid == resource.data.senderId &&
                         request.time < resource.data.timestamp + duration.value(5, 'm');
      }
    }
  }
}
